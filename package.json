{
  "name": "hexmend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/agent-gym.test.mjs tests/agent-gym-constraint.test.mjs tests/agent-gym-diversity.test.mjs tests/agent-gym-layout.test.mjs tests/agent-gym-evidence.test.mjs tests/agent-gym-state-key.test.mjs tests/agent-gym-transfer.test.mjs tests/agent-gym-state-key.test.mjs tests/agent-gym-protocol.test.mjs tests/familiar-gnn.test.mjs tests/patch-review-honesty.test.mjs tests/rendered-html.test.mjs tests/spell-engine.test.mjs tests/tool-evidence-contract.test.mjs tests/webmcp-multi-scenario.test.mjs tests/webmcp-registration.test.mjs tests/webmcp-tools.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs tests/browser-journey.test.mjs",
    "test:deployment": "node --test tests/deployment-readiness.test.mjs",
    "test:submission": "node --test tests/submission-package.test.mjs",
    "capture:submission": "npm run build && node submission/screenshots/capture.mjs",
    "gym:benchmark": "tsx scripts/benchmark-agent-gym.ts",
    "gym:policies": "tsx scripts/benchmark-agent-gym-policies.ts",
    "gym:dataset": "tsx scripts/export-agent-gym-dataset.ts",
    "gym:constraint": "tsx scripts/audit-agent-gym-constraint.ts",
    "gym:evidence": "tsx scripts/report-agent-gym-evidence.ts",
    "gym:transfer": "tsx scripts/benchmark-structural-transfer.ts",
    "gym:verify": "tsx scripts/verify-agent-gym-dataset.ts",
    "gym:preferences": "tsx scripts/export-agent-gym-preferences.ts",
    "gym:preferences:verify": "tsx scripts/verify-agent-gym-preferences.ts",
    "gym:serve": "tsx scripts/serve-agent-gym.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify:live": "node scripts/verify-live-deployment.mjs",
    "brand:render": "tsx scripts/render-brand-assets.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
